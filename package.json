{
  "name": "osint",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "scripts": {
    "predev": "node ./scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "build": "node ./scripts/copy-maplibre-worker.mjs && next build",
    "start": "next start",
    "preview": "node ./scripts/copy-maplibre-worker.mjs && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "bun run data:bus-routes && node ./scripts/copy-maplibre-worker.mjs && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "data:bus-routes": "bun run scripts/fetch-bus-routes.ts",
    "lint": "eslint",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "verify": "bun run typecheck && bun run lint && bun test && bun run build"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.16",
    "maplibre-gl": "^6.16.0",
    "next": "16.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "swr": "^2.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-types": "^1.4.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4.3.4",
    "typescript": "6.0.3",
    "wrangler": "4.159.0"
  }
}

LTA_API_KEY=your_lta_datamall_key
AVIATIONSTACK_API_KEY=your_aviationstack_key

# When deploying behind a trusted reverse proxy (nginx, Cloudflare, etc.),
# set to "true" to trust x-real-ip / x-forwarded-for headers for rate
# limiting. Without this, untrusted-proxy traffic shares a single
# "unknown" bucket to prevent spoofed per-client rate limits.
# ARGUS_TRUST_PROXY_HEADERS=true

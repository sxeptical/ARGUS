LTA_API_KEY=your_lta_datamall_key
AVIATIONSTACK_API_KEY=your_aviationstack_key

# Set to "true" only when every request reaches this app through a trusted
# reverse proxy that overwrites forwarding headers. Cloudflare sets
# cf-connecting-ip from the real peer; otherwise the rightmost x-forwarded-for
# entry (the one appended by the trusted proxy) is used. x-real-ip is ignored.
# Without this, untrusted-proxy traffic shares a single "unknown" bucket to
# prevent spoofed per-client rate limits.
# ARGUS_TRUST_PROXY_HEADERS=true

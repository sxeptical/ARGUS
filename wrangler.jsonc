{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "argus",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Lets the worker call itself (used by OpenNext for cache revalidation).
      "binding": "WORKER_SELF_REFERENCE",
      "service": "argus"
    }
  ],
  // Exposes the deployed version ID to /api/version for the update toast.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "vars": {
    // Tells lib/rate-limit.ts to trust the edge-set cf-connecting-ip header.
    "ARGUS_ON_CLOUDFLARE": "1"
  },
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  }
  // LTA_API_KEY and AVIATIONSTACK_API_KEY are secrets:
  //   bunx wrangler secret put LTA_API_KEY
  //   bunx wrangler secret put AVIATIONSTACK_API_KEY
}
